{
  "manifest_version": 3,
  "name": "Quick Notes",
  "version": "1.0.1",
  "description": "A simple note-taking side panel",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Open Quick Notes"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'"
  }
}